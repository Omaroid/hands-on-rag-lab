# DOCUMENTARY ONLY. Not a runnable Terraform module: .example extension is intentional.
# Azure resources cost money. No provider credentials, state, plan or apply is supplied.
terraform {
  required_version = ">= 1.9.0"
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 4.0" }
  }
}
# Design after an explicit paid-environment approval:
# resource "azurerm_container_app" "api" { ... managed_identity ... }
# resource "azurerm_cognitive_account" "azure_openai" { ... private endpoint ... }
# Use a dedicated Databricks workspace; Unity Catalog governs document lineage and ACLs.
# Databricks Vector Search replaces the Qdrant adapter; apply ACL filters BEFORE retrieval.
# MLflow remains local until an approved managed tracking environment exists.
