# No remote model requests are enabled by this application.
APP_ORIGIN=http://localhost:8000
QUOTA_DB=work/quotas.sqlite
# Generate locally using: python -c 'import secrets; print(secrets.token_hex(32))'
ANONYMIZATION_SECRET=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=lakehouse_rag_lab_v1
# local-hash is an educational non-semantic baseline. e5 requires local model files.
EMBEDDING_BACKEND=local-hash
# Public serverless mode requires an external atomic quota service; otherwise fail closed.
PUBLIC_SERVERLESS=false
