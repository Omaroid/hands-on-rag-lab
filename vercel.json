{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":"VITE_RUNTIME=browser npm run build --prefix frontend",
  "installCommand":"npm ci --prefix frontend",
  "outputDirectory":"frontend/dist",
  "headers":[{"source":"/(.*)","headers":[
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"},
    {"key":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains"},
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"}
  ]}]
}
