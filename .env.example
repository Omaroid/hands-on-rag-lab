# Public PDF application — configure these only on the Vercel server.
# No real key belongs in this file or in any VITE_* variable.
NVIDIA_API_KEY=
RAG_PUBLIC_GENERATION=false

# Optional legacy Python lab; unrelated to public PDF generation.
APP_ORIGIN=http://localhost:8000
QUOTA_DB=work/quotas.sqlite
# Generate a local value with: python -c 'import secrets; print(secrets.token_hex(32))'
ANONYMIZATION_SECRET=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=lakehouse_rag_lab_v1
EMBEDDING_BACKEND=local-hash
EMBEDDING_MODEL_DIR=
PUBLIC_SERVERLESS=false
# Legacy Python provider path stays disabled by default.
NVIDIA_INFERENCE_ENABLED=false
NVIDIA_FREE_TIER_CONFIRMED=false
